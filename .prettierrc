{
  "semi": true,
  "singleQuote": true,
  "singleAttributePerLine": false,
  "htmlWhitespaceSensitivity": "css",
  "printWidth": 100,
  "tabWidth": 2,
  "overrides": [
    {
      "files": "*.blade.php",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.yml",
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
